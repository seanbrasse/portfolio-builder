# The database. Without these the site serves the content in
# src/content/issue.ts and /admin redirects to /, which is the state the
# project shipped in — a missing variable changes where content comes from,
# not whether the site builds.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "Start from a link" on the Add project screen. With this key set, pasting a
# GitHub repo (or any URL) drafts the project's fields with Claude; without it
# the rest of the admin is unaffected and that one button reports it is not
# configured. ANTHROPIC_MODEL is optional and defaults to claude-sonnet-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional: lifts GitHub's 60-req/hour unauthenticated API limit used when
# reading a pasted repo. A fine-grained token with public read access is enough.
GITHUB_TOKEN=
